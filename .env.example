# Copy to .env and fill in.
# .env is gitignored; never commit secrets.

# GitHub OAuth App credentials (https://github.com/settings/developers)
# Authorization callback URL must equal: ${AC_BASE_URL}/auth/github/callback
AC_GITHUB_CLIENT_ID=
AC_GITHUB_CLIENT_SECRET=

# 32-byte random secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AC_SESSION_SECRET=

# Public origin (no trailing slash). Used for OAuth redirect_uri and Bootstrap URL rendering.
AC_BASE_URL=https://battler.al.jrient.cn

# Optional HTTPS proxy for outbound Node fetch (used for github.com OAuth from inside the container).
# If the host runs Clash on 127.0.0.1:7890, use host.docker.internal so the container can reach it.
# Leave blank in environments with direct internet access.
# HTTPS_PROXY=http://host.docker.internal:7890
