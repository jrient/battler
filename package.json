{
  "name": "agentclash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first turn-based tactical battle platform",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --experimental-vm-modules dist/server/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "match": "tsx src/cli/run-match.ts",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
